# JEV API Key 必须由用户在网页端「设置」中手动输入（保存到 server/data/settings.json）。
# 环境变量仅作为可选回退，默认留空。
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# ===== LLM（可选，OpenAI 兼容接口，用于生成更自然的回复文本）=====
# 示例：DeepSeek: https://api.deepseek.com/v1  model=deepseek-chat
# 示例：OpenAI:  https://api.openai.com/v1    model=gpt-4o-mini
# 同样可以在网页端「设置」里填写；不填写时使用内置回复合成器
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

PORT=8787